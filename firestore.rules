rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function userProfileFields() {
      return [
        "credentialName",
        "credentialUpdatedAt",
        "prescriptionLayout",
        "prescriptionLayoutUpdatedAt",
        "email",
        "emailUpdatedAt"
      ];
    }

    match /users/{userId} {
      allow read: if signedInAs(userId);
      allow create: if signedInAs(userId)
        && request.resource.data.keys().hasOnly(userProfileFields());
      allow update: if signedInAs(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(userProfileFields());
      allow delete: if false;

      match /notes/{noteId} {
        allow read, delete: if signedInAs(userId);
        allow create, update: if signedInAs(userId)
          && request.resource.data.visitDate is string
          && request.resource.data.isDraft is bool
          && request.resource.data.transcription is string;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
